#!/bin/bash

RTID=$$

### SYSTEM INFO ###
#Detect the machine we're on
RT_DIR=${RT_DIR:-${PWD}/..}
if [[ -f "${RT_DIR}/detect_machine.sh" ]]; then
    source "${RT_DIR}/detect_machine.sh"
else
    echo "ERROR: Cannot find detect_machine.sh script"
    exit 1
fi

case ${MACHINE_ID,,} in
    hercules)
        WORK_DIR="/work2/noaa/stmp/${LOGNAME}/ufs_utils"
        HOMEreg="/work/noaa/nems/role-nems/ufs_utils.hercules/reg_tests"
        PROJECT_CODE="nems"
        QUEUE="batch"
        SCHEDULER="slurm"
        COMPILER="intelllvm"
        PARTITION="hercules"
        APRUN_ADDITIONS=""
        ;;
    orion)
        WORK_DIR="/work/noaa/stmp/${LOGNAME}/ufs_utils"
        HOMEreg="/work/noaa/nems/role-nems/ufs_utils/reg_tests"
        PROJECT_CODE="nems"
        QUEUE="batch"
        SCHEDULER="slurm"
        COMPILER="intelllvm"
        PARTITION="orion"
        APRUN_ADDITIONS=""
        ;;
    ursa)
        WORK_DIR="/scratch4/NCEPDEV/stmp/${LOGNAME}/ufs_utils"
        HOMEreg="/scratch3/NCEPDEV/nems/role.ufsutils/ufs_utils/reg_tests"
        PROJECT_CODE="nems"
        QUEUE="batch"
        SCHEDULER="slurm"
        COMPILER="intelllvm"
        PARTITION="u1-compute"
        APRUN_ADDITIONS=""
        ;;
    gaeac6)
        WORK_DIR="/gpfs/f6/infra-cpu/scratch/${LOGNAME}/ufs_utils"
        HOMEreg="/gpfs/f6/infra-cpu/world-shared/emc.nemspara/ufs_utils/reg_tests"
        PROJECT_CODE="infra-cpu"
        QUEUE="normal"
        SCHEDULER="slurm"
        COMPILER="intelllvm"
        PARTITION="c6"
        SLURM_CLUSTER="c6"
        APRUN_ADDITIONS=""
        ;;
    wcoss2)
        WORK_DIR="/lfs/h2/emc/stmp/${LOGNAME}/ufs_utils"
        HOMEreg="/lfs/h2/emc/nems/noscrub/emc.nems/UFS_UTILS/reg_tests"
        PROJECT_CODE="GFS-DEV"
        QUEUE="dev"
        SCHEDULER="pbs"
        COMPILER="intel"
        PARTITION="dev"
        APRUN_ADDITIONS=""
        ;;
    nimbus)
        WORK_DIR="/home/${LOGNAME}/ufs_utils"
        HOMEreg="/home/${LOGNAME}/ufs_utils/reg_tests"
        PROJECT_CODE=""
        QUEUE=""
        SCHEDULER="slurm"
        COMPILER="intelllvm"
        PARTITION="compute"
        APRUN_ADDITIONS="--mpi=pmi2"

        if [[ ${COMPILER} == "intelllvm" ]]; then
            # module load pmix/5.0.11

            export I_MPI_HYDRA_IFACE=rdma0
            export FI_OFI_RXM_USE_ENV_ANY=1
            export FI_TCP_IFACE=rdma0
            export FI_VERBS_IFACE=rdma0

            export FI_PROVIDER="verbs;ofi_rxm"

            export FI_VERBS_INLINE_SIZE=39
            export FI_OFI_RXM_BUFFER_SIZE=4096
            # export FI_UNIVERSE_SIZE=$SLURM_NTASKS
            export FI_OFI_RXM_SAR_LIMIT=2147483648

            export I_MPI_PIN_DOMAIN=numa

            export I_MPI_DEBUG=5
            
            # export I_MPI_PMI_LIBRARY=/usr/lib64/libpmi2.so
            # export I_MPI_OFI_PROVIDER=tcp
        fi

        
        ;;
    *)
        echo "Error: Unsupported machine '${MACHINE_ID}'"
        exit 1
        ;;
esac

##### TOGGLE JOBS #########
RUN_CHGRES_CUBE="true"
RUN_CPLD_GRIDGEN="true"
RUN_GLOBAL_CYCLE="true"
RUN_GRID_GEN="true"
RUN_ICE_BLEND="true"
RUN_OCNICE_PREP="true"
RUN_REGRID_SFC="true"
RUN_SNOW2MDL="true"
RUN_WEIGHT_GEN="true"
###############

# Where to send mail when job is completed?
# Please use quotes and put a space between multiple email addresses.
MAILTO="brian.curtis@noaa.gov"

HOMEUFSUTILS="${RT_DIR}/.."
export HOMEUFSUTILS

### RT SETTINGS ###
TIMEOUT_LIMIT=3600
UPDATE_BASELINE="FALSE"
######

### REPO INFO ###
# REPO_BRANCH="develop"
# # REPO_LOC="https://github.com/ufs-community/UFS_UTILS.git"
# REPO_LOC="git@github.com:ufs-community/UFS_UTILS.git"
REPO_BRANCH="nimbus"
# REPO_LOC="https://github.com/ufs-community/UFS_UTILS.git"
REPO_LOC="git@github.com:BrianCurtis-NOAA/UFS_UTILS.git"
######

# Shouldn't need to edit below here #

# shellcheck source=/dev/null
source "${HOMEUFSUTILS}/sorc/machine-setup.sh" > /dev/null 2>&1
module use "${HOMEUFSUTILS}/modulefiles"
module load "build.${MACHINE_ID,,}.${COMPILER}"
module list

if [ "${MACHINE_ID,,}" == "hercules" ]; then
    ulimit -s unlimited
fi

# If there are any major new additions or subtractions, this will need to be updated
RUN_CATALOG=("RUN_CHGRES_CUBE" "RUN_CPLD_GRIDGEN" "RUN_GLOBAL_CYCLE" "RUN_GRID_GEN" "RUN_ICE_BLEND" "RUN_OCNICE_PREP"
"RUN_REGRID_SFC" "RUN_SNOW2MDL" "RUN_WEIGHT_GEN")

RUN_SET=()
for var_name in "${RUN_CATALOG[@]}"; do
    value="${!var_name}"
    if [[ "$value" == "true" ]]; then
        RUN_SET+=("$var_name")
    fi
done

compiler=${COMPILER}

export MAILTO WORK_DIR HOMEreg PROJECT_CODE QUEUE SCHEDULER TIMEOUT_LIMIT
export RUN_SET REPO_BRANCH REPO_LOC RTID MACHINE_ID UPDATE_BASELINE compiler
